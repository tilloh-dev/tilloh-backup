# ============================================================================
# FreeToken config  —  copy to "config.env" and adjust.
# Sourced by bootstrap.sh, download-model.sh and server.sh.
# config.env is gitignored (machine-specific); this .example is committed.
#
# Runtime: WSL2/Linux only. FreeToken has no Windows wheels (see config-load.sh).
# Requires an NVIDIA driver r580+ and a CUDA 13 toolkit (nvcc on PATH) for the
# JIT-compiled kernels — bootstrap.sh checks for both.
# ============================================================================

# FreeToken release to install into the venv: "latest" or a pinned version like "0.1.2".
FT_VERSION="latest"

# Where model checkpoints live  —  OUTSIDE this repo, never committed.
# FreeToken loads a whole HF checkpoint DIRECTORY (safetensors + config), not a
# single file, so each model is a subdirectory here.
FT_MODELS_DIR="$HOME/.local/share/freetoken/models"

# API server network binding (FreeToken default port is 1919).
FT_HOST="127.0.0.1"
FT_PORT="1919"

# Default preset (a file in presets/, without the .env suffix) that server.sh
# serves when called with no model argument. One preset = one model; FreeToken
# has no multi-model router, so pick the model you serve most.
FT_PRESET="qwen3.6-35B-A3B"

# MoE execution backend: auto | fused | offload | cpu | hybrid.
# auto -> offload for MoE (experts in host RAM, LRU expert cache on GPU),
# upgraded to hybrid when a `ft bench bw` profile recommends it.
FT_MOE_BACKEND="auto"

# Fraction of free VRAM the engine may use (weights + MoE cache + KV).
FT_MEMORY_RATIO="0.9"

# Default output-token budget for requests that omit one.
FT_MAX_OUTPUT_TOKENS="32768"

# Extra flags appended verbatim to every `ft serve` (leave empty by default).
FT_EXTRA_ARGS=""

# Optional: HuggingFace token for gated/private downloads (or run 'hf auth login').
HF_TOKEN=""
