# FreeToken preset — Qwen3.6-35B-A3B-FP8
#
# 35B MoE, 3B active, FP8 (~35 GB). The safe hermine pick: fits comfortably in
# 48 GB host RAM, so the offload backend keeps all experts resident and only the
# LRU expert cache lives on the 4090. Directly comparable to the llama.cpp router
# entry `Qwen3.6-35B-A3B` (q8_0) for an A/B against the two engines.
#
# Sourced by server.sh; every FT_* here overrides config.env for this model only.

FT_MODEL_REPO="Qwen/Qwen3.6-35B-A3B-FP8"
FT_MODEL_DIR="Qwen3.6-35B-A3B-FP8"
FT_SERVED_NAME="Qwen3.6-35B-A3B"

# auto -> offload for this MoE. `ft bench bw` (run in bootstrap) may upgrade it to
# hybrid; leave auto to honour that profile.
FT_MOE_BACKEND="auto"

# Sampling is read from the checkpoint's generation_config.json via ft's default
# (--sampling-defaults model). Qwen3.6 coding runs use temp 0.6 in the llama.cpp
# presets; override here only if a measurement says the checkpoint default is off.
FT_EXTRA_ARGS=""
