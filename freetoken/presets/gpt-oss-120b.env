# FreeToken preset — gpt-oss-120b (MXFP4)
#
# 120B MoE, ~5B active, native MXFP4 (~63 GB). The offload showcase: far too big
# for the 4090's 23 GB, so it exercises FreeToken's whole reason to exist.
#
# MARGINAL ON HERMINE — READ BEFORE SERVING. The offload backend needs the expert
# weights (~58 GB of the 63 GB) resident in HOST RAM. hermine has 48 GB physical,
# and WSL only sees what .wslconfig grants it (currently memory=40GB). 40 GB RAM
# cannot hold ~58 GB of experts, so this WILL spill to SSD (slow) or OOM unless:
#   1. raise WSL RAM in C:\Users\Anwender\.wslconfig to `memory=44GB` (host has 48),
#      then `wsl --shutdown` from Windows and reopen; AND
#   2. accept that even 44 GB RAM + GPU expert cache is a tight fit — measure with
#      `ft ctl stats` and watch for disk paging.
# If it does not hold, fall back to the Qwen preset. Do not treat this as "works"
# until a real serve on this box confirms it (numbers -> docs/freetoken-operations.md).

FT_MODEL_REPO="openai/gpt-oss-120b"
FT_MODEL_DIR="gpt-oss-120b"
FT_SERVED_NAME="gpt-oss-120b"

# Force offload explicitly; on this RAM-starved box hybrid (some experts computed
# on CPU) may be the only thing that fits — decide from `ft bench bw` + a real load.
FT_MOE_BACKEND="offload"

FT_EXTRA_ARGS=""
