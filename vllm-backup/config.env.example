# vllm-backup config — copy to config.env (gitignored) and adjust.
# Same idea as llama.cpp/config.env: paths + port live here, scripts source it.

# Where HF-format models are stored. NOTE: unlike llama.cpp (E:), vLLM loads
# ~20 GB safetensors at every server start — WSL-ext4 is ~5-10x faster than
# /mnt/e (drvfs), so the default lives inside WSL.
VLLM_MODELS_DIR="$HOME/.local/share/vllm/models"

# OpenAI-compatible server bind. 0.0.0.0 so Windows-side clients can reach it
# (same WSL trap as llama.cpp: 127.0.0.1 here is the WSL loopback only).
VLLM_HOST="0.0.0.0"
VLLM_PORT="8091"

# Model to serve (HF repo id, downloaded into VLLM_MODELS_DIR by install.sh)
VLLM_MODEL="dbirks/Qwen3.8-27B-W4A16-AutoRound"
VLLM_SERVED_NAME="Qwen3.8-27B-vllm"

# Context + memory. KV lives in VRAM (no CPU-MoE/mmap tricks like llama.cpp):
# max-model-len directly trades against weights on the 24 GB card.
VLLM_MAX_MODEL_LEN="131072"
VLLM_GPU_MEM_UTIL="0.90"
VLLM_KV_CACHE_DTYPE="auto"

# Single-user serving (the llama.cpp parallel=1 analogue). Raise for batch use.
VLLM_MAX_NUM_SEQS="1"
