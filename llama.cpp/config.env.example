# ============================================================================
# llama.cpp Linux config  —  copy to "config.env" and adjust.
# Sourced by bootstrap.sh, download-model.sh and server.sh.
# The scripts auto-detect their own location; you only set values here.
# config.env is gitignored (machine-specific); this .example is committed.
# ============================================================================

# llama.cpp release to install: "latest" (recommended) or a pinned tag like "b9827".
LLAMA_VERSION="latest"

# Compute backend of the prebuilt binary (this setup targets Vulkan).
LLAMA_BACKEND="vulkan"

# server.sh checks for updates on every start (via bootstrap.sh) and installs
# a newer LLAMA_VERSION automatically if one is available. Set to "0" to
# disable entirely (fully offline / air-gapped use).
LLAMA_AUTO_UPDATE="1"

# Minimum seconds between auto-update checks (avoids hitting GitHub's API rate
# limit on frequent restarts). 0 = check on every server start.
LLAMA_UPDATE_CHECK_INTERVAL="3600"

# Where GGUF models live  —  OUTSIDE this repo, never committed.
LLAMA_MODELS_DIR="$HOME/.local/share/llama.cpp/models"

# llama-server network binding.
LLAMA_HOST="127.0.0.1"
LLAMA_PORT="8081"

# Router mode (multi-model): preset file (relative to llama.cpp/) + max loaded.
LLAMA_PRESET="presets/models.ini"
LLAMA_MODELS_MAX="1"

# Single-model mode defaults (override per run, e.g.  LLAMA_CTX=8192 ./server.sh m.gguf).
LLAMA_NGL="999"     # GPU layers to offload (999 = all; clamped automatically)
LLAMA_CTX="0"       # context size (0 = use the model's trained context)
LLAMA_KV="f16"      # KV cache type: f32, f16, q8_0, q4_0

# Optional: HuggingFace token for gated/private downloads (or run 'hf auth login').
HF_TOKEN=""

# --- Health check (tools/healthcheck.sh) ------------------------------------
# Detects a model evicted from VRAM into host memory at runtime and restarts
# the serving unit. Measured failure it exists for: same process at 20405 MiB
# VRAM after loading, 26 MiB VRAM / 15986 MiB GTT minutes later (Gertrude,
# 2026-09-24). Install the units from tools/systemd/.
LLAMA_HEALTHCHECK_UNIT="llama-server.service"   # unit to restart; use your single-model unit if not the router
LLAMA_HEALTHCHECK_DETECTOR="auto"               # auto | amdgpu  (CUDA hosts need a throughput probe, see the script header)
LLAMA_HEALTHCHECK_MIN_GTT_MIB="4096"            # below this, host-side GPU memory is normal overhead
LLAMA_HEALTHCHECK_STRIKES="2"                   # consecutive detections before restarting (a restart kills a running generation)
LLAMA_HEALTHCHECK_RESTART="1"                   # 0 = log only, never restart
LLAMA_HEALTHCHECK_SETTLE="90"                   # seconds after a unit restart to skip checking (loading a 16 GiB model looks like an eviction from outside)
