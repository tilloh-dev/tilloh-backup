# ============================================================================
# comfyui-backup config — copy to "config.env" (gitignored) and adjust.
# Sourced by install.sh, download-models.sh and serve.sh.
# ============================================================================

# Where ComfyUI itself is checked out. Deliberately OUTSIDE this repo: its
# models/ subtree holds tens of GB and must never be committed, and ComfyUI
# insists on finding models relative to its own directory.
COMFY_DIR="$HOME/.local/share/comfyui/ComfyUI"

# Network bind. 0.0.0.0 is required, not cosmetic: the Hermes agent runs in a
# Docker container and reaches the host over a bridge gateway (172.20.0.1 on
# Gertrude), so a 127.0.0.1 bind would be invisible to it.
COMFY_HOST="0.0.0.0"
COMFY_PORT="8188"

# PyTorch CUDA wheel index. cu121 is chosen against driver 535.309.01: a CUDA
# 12.x build runs on any >= 525 driver via minor-version compatibility, but
# staying on 12.1 avoids relying on that at all.
COMFY_TORCH_INDEX="https://download.pytorch.org/whl/cu121"

# Which GPU PyTorch may use. The AMD card is not a CUDA device at all, so this
# cannot collide with llama.cpp — index 0 is the RTX 3060 and the only entry.
COMFY_CUDA_DEVICE="0"

# Extra llama-server-style knobs. Qwen-Image-2.1 Q4 plus a bf16 text encoder
# does not fit 12 GB together; --lowvram keeps the encoder off the card.
# Drop it if a smaller encoder (int8/w4a8) is used instead.
COMFY_EXTRA_ARGS="--lowvram"

# Optional: HuggingFace token for gated downloads (or run 'hf auth login').
HF_TOKEN=""
