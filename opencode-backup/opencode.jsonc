{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["opencode-claude-auth@latest"],
  "enabled_providers": ["lieselotte", "hermine", "anthropic", "elektronengehirn"],
  "share": "disabled",
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {},
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "provider": {
    "lieselotte": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (lieselotte)",
      "options": {
        "baseURL": "http://127.0.0.1:8081/v1",
        "apiKey": "no-key"
      },
      "models": {
        "Qwen3.8-27B": {
          "name": "Qwen3.8 27B Dense MTP",
          "modalities": {"input": ["text", "image", "video"], "output": ["text"]}
        },
        "Qwen3.6-27B": {
          "name": "Qwen3.6 27B Dense MTP",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6 35B-A3B MoE",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "gemma-4-26B-A4B": {
          "name": "Gemma 4 26B-A4B",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Ornith-1.0-9B": {
          "name": "Ornith 1.0 9B Dense",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ornith-1.0-35B": {
          "name": "Ornith 1.0 35B MoE",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ornith-1.5-35B-A3B": {
          "name": "Ornith 1.5 35B-A3B MoE Agentic Coder",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Qwen-AgentWorld-35B-A3B": {
          "name": "Qwen-AgentWorld 35B-A3B World Model",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "gemma-4-31B": {
          "name": "Gemma 4 31B Dense QAT + MTP",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Laguna-XS-2.1": {
          "name": "Laguna XS 2.1 33B-A3B Agentic Coder",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ternary-Bonsai-27B": {
          "name": "Ternary Bonsai 27B (1.71 bpw)",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Muse-Glimmer-30B": {
          "name": "Muse Glimmer 30B Dense Agentic + DFlash",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Nemotron-3.5-Lightning-30B-A3B": {
          "name": "Nemotron 3.5 Lightning 30B-A3B Mamba2 Hybrid",
          "modalities": {"input": ["text"], "output": ["text"]}
        }
      },
      "whitelist": ["Qwen3.8-27B", "Qwen3.6-27B", "Qwen3.6-35B-A3B", "gemma-4-26B-A4B", "Ornith-1.0-9B", "Ornith-1.0-35B", "Ornith-1.5-35B-A3B", "Qwen-AgentWorld-35B-A3B", "gemma-4-31B", "Laguna-XS-2.1", "Ternary-Bonsai-27B", "Muse-Glimmer-30B", "Nemotron-3.5-Lightning-30B-A3B"]
    },
    "hermine": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (hermine)",
      "options": {
        "baseURL": "http://hermine:8081/v1",
        "apiKey": "no-key"
      },
      "models": {
        "Qwen3.8-27B-UD-Q4_K_M-200ctx-q4_0": {
          "name": "Qwen3.8 27B Dense 200k q4_0",
          "modalities": {"input": ["text", "image", "video"], "output": ["text"]}
        },
        "Qwen3.8-27B-UD-Q4_K_M-150ctx-q8_0": {
          "name": "Qwen3.8 27B Dense 150k q8_0",
          "modalities": {"input": ["text", "image", "video"], "output": ["text"]}
        },
        "Qwen3.6-27B": {
          "name": "Qwen3.6 27B Dense MTP",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6 35B-A3B MoE",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "gemma-4-26B-A4B": {
          "name": "Gemma 4 26B-A4B",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Ornith-1.0-9B": {
          "name": "Ornith 1.0 9B Dense",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ornith-1.0-35B": {
          "name": "Ornith 1.0 35B MoE",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ornith-1.5-35B-A3B": {
          "name": "Ornith 1.5 35B-A3B MoE Agentic Coder",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Qwen-AgentWorld-35B-A3B": {
          "name": "Qwen-AgentWorld 35B-A3B World Model",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "gemma-4-31B": {
          "name": "Gemma 4 31B Dense QAT + MTP",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Laguna-XS-2.1": {
          "name": "Laguna XS 2.1 33B-A3B Agentic Coder",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ternary-Bonsai-27B": {
          "name": "Ternary Bonsai 27B (1.71 bpw)",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Muse-Glimmer-30B": {
          "name": "Muse Glimmer 30B Dense Agentic + DFlash",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Nemotron-3.5-Lightning-30B-A3B": {
          "name": "Nemotron 3.5 Lightning 30B-A3B Mamba2 Hybrid",
          "modalities": {"input": ["text"], "output": ["text"]}
        }
      },
      "whitelist": ["Qwen3.8-27B-UD-Q4_K_M-200ctx-q4_0", "Qwen3.8-27B-UD-Q4_K_M-150ctx-q8_0", "Qwen3.6-27B", "Qwen3.6-35B-A3B", "gemma-4-26B-A4B", "Ornith-1.0-9B", "Ornith-1.0-35B", "Ornith-1.5-35B-A3B", "Qwen-AgentWorld-35B-A3B", "gemma-4-31B", "Laguna-XS-2.1", "Ternary-Bonsai-27B", "Muse-Glimmer-30B", "Nemotron-3.5-Lightning-30B-A3B", "Qwen3.8-27B-large"]
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "elektronengehirn": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Elektronengehirn (stadt.werk)",
      "options": {
        "baseURL": "https://elektronengehirn.stadtwerk.org/v1",
        "apiKey": "{env:ELEKTRONENGEHIRN_API_KEY}"
      },
      "models": {
        "gemma-3-12b-it": {
          "name": "Gemma 3 12B IT",
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  }
}
