{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["opencode-claude-auth@latest"],
  "enabled_providers": [
    "lieselotte",
    "hermine",
    "anthropic",
    "elektronengehirn",
    "openrouter"
  ],
  "share": "disabled",
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {},
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "whitelist": [
        "deepseek/deepseek-v4-pro-0813",
        "deepseek/deepseek-v4-flash-0731",
        "deepseek/deepseek-v4.1-flash",
        "z-ai/glm-5.3-flash"
      ],
      "models": {
        "deepseek/deepseek-v4-pro-0813": {
          "options": {
            "provider": {
              "only": [
                "nextbit"
              ],
              "allow_fallbacks": false,
              "data_collection": "deny"
            }
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "provider": {
              "only": [
                "nextbit"
              ],
              "allow_fallbacks": false,
              "data_collection": "deny"
            }
          }
        },
        "deepseek/deepseek-v4.1-flash": {
          "options": {
            "provider": {
              "only": [
                "novita"
              ],
              "allow_fallbacks": false,
              "data_collection": "deny"
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "options": {
            "provider": {
              "only": [
                "nextbit"
              ],
              "allow_fallbacks": false,
              "data_collection": "deny"
            }
          }
        }
      }
    },
    "lieselotte": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (lieselotte)",
      "options": {
        "baseURL": "http://127.0.0.1:8081/v1",
        "apiKey": "no-key"
      },
      "models": {
        "Qwen3.8-27B": {
          "name": "Qwen3.8 27B Dense 27B VLM, GSQ-RCO IQ3_S, 262k ctx",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Qwen3.8-Flash-Next": {
          "name": "Qwen3.8 Flash Next 125B MoE (6B active) via mmap, 262k ctx, ~20-23 t/s",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6 35B-A3B MoE, 262k ctx",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ornith-1.5-35B-A3B": {
          "name": "Ornith-1.5 35B-A3B MoE agentic coder, 164k ctx",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Laguna-XS-2.1": {
          "name": "Laguna XS 2.1 33B-A3B Agentic Coder",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ternary-Bonsai-27B": {
          "name": "Ternary Bonsai 27B (1.71 bpw)",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Muse-Glimmer-30B": {
          "name": "Muse Glimmer 30B Dense Agentic + DFlash",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        }
      },
      "whitelist": ["Qwen3.8-27B", "Qwen3.8-Flash-Next", "Qwen3.6-35B-A3B", "Ornith-1.5-35B-A3B", "Laguna-XS-2.1", "Ternary-Bonsai-27B", "Muse-Glimmer-30B"]
    },
    "hermine": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (hermine)",
      "options": {
        "baseURL": "http://hermine:8081/v1",
        "apiKey": "no-key"
      },
      "models": {
        "Qwen3.8-27B": {
          "name": "Qwen3.8 27B Dense 27B VLM, GSQ-RCO IQ3_S, 262k ctx",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Qwen3.8-Flash-Next": {
          "name": "Qwen3.8 Flash Next 125B MoE (6B active) via mmap, 262k ctx, ~20-23 t/s",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6 35B-A3B MoE, 262k ctx",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ornith-1.5-35B-A3B": {
          "name": "Ornith-1.5 35B-A3B MoE agentic coder, 164k ctx",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        },
        "Laguna-XS-2.1": {
          "name": "Laguna XS 2.1 33B-A3B Agentic Coder",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Ternary-Bonsai-27B": {
          "name": "Ternary Bonsai 27B (1.71 bpw)",
          "modalities": {"input": ["text"], "output": ["text"]}
        },
        "Muse-Glimmer-30B": {
          "name": "Muse Glimmer 30B Dense Agentic + DFlash",
          "modalities": {"input": ["text", "image"], "output": ["text"]}
        }
      },
      "whitelist": ["Qwen3.8-27B", "Qwen3.8-Flash-Next", "Qwen3.6-35B-A3B", "Ornith-1.5-35B-A3B", "Laguna-XS-2.1", "Ternary-Bonsai-27B", "Muse-Glimmer-30B"]
    },
    "elektronengehirn": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Elektronengehirn (stadt.werk)",
      "options": {
        "baseURL": "https://elektronengehirn.stadtwerk.org/v1",
        "apiKey": "{env:ELEKTRONENGEHIRN_API_KEY}"
      },
      "models": {
        "gemma-3-12b-it": {
          "name": "Gemma 3 12B IT",
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  }
}
